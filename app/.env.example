# Скопируйте в .env и вставьте токен от @BotFather. Файл .env игнорируется гитом.

# Токен Telegram-бота — только локально, в гит НЕ коммитить
BOT_TOKEN=

# Если api.telegram.org недоступен напрямую, задайте прокси:
# PROXY_URL=http://127.0.0.1:7890

# Максимальная длина текста (по умолчанию 4096)
# MAX_TEXT_LENGTH=4096

# Пути к модели и метаданным (по умолчанию — artifacts/ в корне репозитория)
# MODEL_PATH=../artifacts/baseline_model.joblib
# MODEL_METADATA_PATH=../artifacts/baseline_metadata.json

# База данных PostgreSQL.
# Пусто — поднимается встроенный PostgreSQL (pgserver), данные в папке pgdata/ (игнорируется гитом).
# Можно указать внешний сервер: DB_URL=postgresql://user:password@host:5432/toxicity
# DB_URL=
# PGDATA_DIR=pgdata

# Версия модели для таблицы model_versions (менять при переобучении)
# MODEL_VERSION=baseline
